{
  "name": "connect-internationals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "build": "next build",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-local.cjs",
    "db:seed": "node scripts/run-ts.cjs prisma/seed.ts",
    "test:stage2": "node scripts/run-ts.cjs scripts/verify-stage2.ts",
    "test:persona": "node scripts/run-ts.cjs scripts/verify-persona.ts",
    "test:stage3": "node scripts/run-ts.cjs scripts/verify-stage3.ts",
    "test:stage3:http": "node scripts/run-ts.cjs scripts/verify-stage3-http.ts",
    "test:stage4": "node scripts/run-ts.cjs scripts/run-stage4-tests.ts",
    "test:stage4:http": "STAGE4_HTTP=true node scripts/run-ts.cjs scripts/run-stage4-tests.ts",
    "db:circles": "node scripts/run-ts.cjs prisma/seedCircles.ts",
    "test:stage5": "node scripts/run-ts.cjs scripts/run-stage5-tests.ts",
    "test:stage5:http": "STAGE5_HTTP=true node scripts/run-ts.cjs scripts/run-stage5-tests.ts",
    "test:stage6": "node scripts/run-ts.cjs scripts/run-stage6-tests.ts",
    "test:stage6:http": "STAGE6_HTTP=true node scripts/run-ts.cjs scripts/run-stage6-tests.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "5.9.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.32",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35"
  },
  "prisma": {
    "seed": "node scripts/run-ts.cjs prisma/seed.ts"
  }
}
